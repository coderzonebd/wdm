---
// SPDX-License-Identifier: GPL-3.0-or-later
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-bengali";
import "../styles/global.css";
import { href, REPO, strings, type Lang, type Page } from "../i18n";

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;
const t = strings[lang];
const other: Lang = lang === "en" ? "bn" : "en";
const fullTitle = title ? `${title} · ${t.meta.title}` : t.meta.title;
const desc = description ?? t.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(href(lang, page), Astro.site).toString();
const ogImage = new URL(`${base}og.png`, Astro.site).toString();
const nav: [Page, string][] = [
  ["download", t.nav.download],
  ["extension", t.nav.extension],
  ["benchmarks", t.nav.benchmarks],
  ["faq", t.nav.faq],
];
---
<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href("en", page), Astro.site).toString()} />
    <link rel="alternate" hreflang="bn" href={new URL(href("bn", page), Astro.site).toString()} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2f74ec" />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href(lang, "home")} aria-label={t.meta.title}>
          <img src={`${base}favicon.svg`} alt="" width="30" height="30" />
          <span>Whoosh</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{t.nav.menu}</button>
        <nav class="nav" id="site-nav" aria-label={t.nav.menu}>
          {nav.map(([p, label]) => (
            <a href={href(lang, p)} aria-current={p === page ? "page" : undefined}>{label}</a>
          ))}
          <a href={`${href(lang, "home")}#support`}>{t.nav.support}</a>
          <a href={REPO}>{t.nav.github}</a>
          <a class="lang" href={href(other, page)} hreflang={other} lang={other}>{t.nav.language}</a>
        </nav>
      </div>
    </header>
    <div class="status" role="note">
      <div class="wrap">
        <span class="pill">{t.status.badge}</span>
        <span>{t.status.text} <a href={REPO}>{t.status.follow}</a></span>
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <div>{t.footer.made}</div>
          <div>{t.footer.license}</div>
        </div>
        <nav aria-label="Footer">
          <a href={href(lang, "privacy")}>{t.footer.privacy}</a>
          <a href={REPO}>GitHub</a>
          <a href={href(other, page)} hreflang={other} lang={other}>{t.nav.language}</a>
        </nav>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.getElementById("site-nav");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") !== "true";
        btn.setAttribute("aria-expanded", String(open));
        nav?.setAttribute("data-open", String(open));
      });
    </script>
  </body>
</html>
