---
// SPDX-License-Identifier: GPL-3.0-or-later
import "@fontsource-variable/baloo-da-2";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { href, REPO, strings, type Lang, type Page } from "../i18n";

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;
const t = strings[lang];
const other: Lang = lang === "en" ? "bn" : "en";
const fullTitle = title ? `${title} · ${t.meta.title}` : t.meta.title;
const desc = description ?? t.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(href(lang, page), Astro.site).toString();
const ogImage = new URL(`${base}og.png`, Astro.site).toString();
const nav: [Page, string][] = [
  ["extension", t.nav.extension],
  ["benchmarks", t.nav.benchmarks],
  ["faq", t.nav.faq],
];
---
<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href("en", page), Astro.site).toString()} />
    <link rel="alternate" hreflang="bn" href={new URL(href("bn", page), Astro.site).toString()} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2563eb" />
  </head>
  <body>
    <div class="scrollbar" aria-hidden="true"><i></i></div>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href(lang, "home")}>
          <img src={`${base}favicon.svg`} alt="" width="36" height="36" />
          <span>WDM</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{t.nav.menu}</button>
        <nav class="nav" id="site-nav" aria-label={t.nav.menu}>
          {nav.map(([p, label]) => (
            <a href={href(lang, p)} aria-current={p === page ? "page" : undefined}>{label}</a>
          ))}
          <a href={REPO}>{t.nav.github}</a>
          <a href={href(other, page)} hreflang={other} lang={other}>{t.nav.language}</a>
          <a class="nav-cta" href={href(lang, "download")}><Icon name="download" class="drop" />{t.nav.cta}</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <div>{t.footer.made.split("{company}").map((part, i) => i === 0 ? part : <><a href="https://coderzonebd.com">Coder Zone BD</a>{part}</>)}</div>
          <div>{t.footer.license}</div>
        </div>
        <nav aria-label="Footer">
          <a href={href(lang, "privacy")}>{t.footer.privacy}</a>
          <a href={REPO}>GitHub</a>
          <a href={href(other, page)} hreflang={other} lang={other}>{t.nav.language}</a>
        </nav>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.getElementById("site-nav");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") !== "true";
        btn.setAttribute("aria-expanded", String(open));
        nav?.setAttribute("data-open", String(open));
      });

      // The two data plays (bars, kill grid): once, when scrolled into view.
      // Without JS or with reduced motion the final state is what the CSS shows.
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const plays = [...document.querySelectorAll<HTMLElement>("[data-play]")];
      if (!still && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              const el = e.target as HTMLElement;
              if (el.dataset.play === "power") power(el);
              else el.classList.replace("js-play", "js-played");
            }
          },
          { threshold: 0.35 },
        );
        for (const el of plays) {
          el.classList.add("js-play");
          io.observe(el);
        }
      }
      // Sections come up once as they scroll into view.
      if (document.documentElement.classList.contains("js") && "IntersectionObserver" in window) {
        const seen = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              seen.unobserve(e.target);
              e.target.classList.add("in");
              const n = e.target.querySelector<HTMLElement>("[data-count]") ?? (e.target.matches("[data-count]") ? (e.target as HTMLElement) : null);
              if (n) count(n);
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
        );
        for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
      }
      // Counts a figure up to its value, in the page's own digits.
      function count(el: HTMLElement) {
        const to = Number(el.dataset.count);
        const fmt = new Intl.NumberFormat(document.documentElement.lang === "bn" ? "bn-BD" : "en-US");
        const start = performance.now();
        const total = 1200;
        const tick = (now: number) => {
          const k = Math.min(1, (now - start) / total);
          el.textContent = fmt.format(Math.round(to * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
      // Fills to the cut, the power goes out (the lit part dims, a bolt strikes), then it carries on.
      function power(el: HTMLElement) {
        const cells = [...el.querySelectorAll("i")];
        const cut = Number(el.dataset.cut);
        const box = el.closest(".power");
        const per = 28;
        const pause = 900;
        cells.forEach((cell, i) => {
          setTimeout(() => {
            cell.classList.add("on");
            if (i === cells.length - 1) el.classList.remove("js-play");
          }, i * per + (i >= cut ? pause : 0));
        });
        setTimeout(() => box?.classList.add("is-out", "struck"), cut * per);
        setTimeout(() => box?.classList.remove("is-out"), cut * per + pause);
      }

      // The page's own download bar: how far you have scrolled.
      const bar = document.querySelector<HTMLElement>(".scrollbar i");
      if (bar) {
        let queued = false;
        const paint = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        };
        addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
        paint();
      }
    </script>
  </body>
</html>
