---
// SPDX-License-Identifier: GPL-3.0-or-later
// 1,000 squares: one per kill -9 in the crash test (40 columns × 25 rows).
interface Props { label: string }
const { label } = Astro.props;
const COLS = 40, ROWS = 25, STEP = 12, SIZE = 9;
const cells = Array.from({ length: COLS * ROWS }, (_, i) => ({ x: (i % COLS) * STEP, y: Math.floor(i / COLS) * STEP }));
---
<svg class="kill-grid" data-play="grid" viewBox={`0 0 ${COLS * STEP - (STEP - SIZE)} ${ROWS * STEP - (STEP - SIZE)}`} role="img" aria-label={label}>
  {cells.map((c) => <rect x={c.x} y={c.y} width={SIZE} height={SIZE} />)}
</svg>
