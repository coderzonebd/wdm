---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import PageHead from "./PageHead.astro";
import { REPO, strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = strings[lang].download;
---
<Base lang={lang} page="download" title={d.title}>
  <PageHead title={d.title} lead={d.lead} />
  <div class="page-body"><div class="wrap">
    <h2>{d.platformsTitle}</h2>
    <dl class="rows" data-reveal>
      {d.platforms.map((p) => <div><dt>{p.name}</dt><dd>{p.items.join(", ")}</dd></div>)}
    </dl>
    <h2>{d.signingTitle}</h2>
    <dl class="rows" data-reveal>
      <div><dt>Windows</dt><dd>{d.signingWindows}</dd></div>
      <div><dt>macOS</dt><dd>{d.signingMac}</dd></div>
    </dl>
    <h2>{d.verifyTitle}</h2>
    <p class="prose muted">{d.verifyText}</p>
    <pre><code>{d.verifyCode}</code></pre>
    <h2>{d.sourceTitle}</h2>
    <p class="prose muted">{d.sourceText} <a href={`${REPO}#quick-start`}>GitHub</a></p>
  </div></div>
</Base>
