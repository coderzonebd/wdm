---
// SPDX-License-Identifier: GPL-3.0-or-later
// The download page. The browser works out the visitor's system and shows its installer first,
// with that system's one-line install command under it; then every system and file, both
// install commands, and what to expect on the first start. The file list comes from the newest
// release, read when the site is built; files come straight from GitHub's release servers.
import Base from "../layouts/Base.astro";
import PageHead from "./PageHead.astro";
import Icon, { type IconName } from "./Icon.astro";
import { REPO, num, strings, type Lang } from "../i18n";
import { files, latestRelease, size, type Kind } from "../lib/release";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = strings[lang].download;
const release = await latestRelease();
const got = files(release);
const icons: Record<string, IconName> = { windows: "windows", mac: "laptop", linux: "terminal", android: "phone" };
const fill = (text: string, key: string, value: string) => text.replace(`{${key}}`, value);
const osNames = d.osNames as Record<string, string>;
// The install script, served by this site (the deploy workflow copies it from the app's
// repository), so the commands are short enough for one line.
const script = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}install.txt`, Astro.site).href;
const commands = d.commands.map((c) => ({ ...c, code: c.code.replace("{script}", script) }));
const [unixCmd, windowsCmd] = commands;
/** A file's short label (".deb · x64"), from the list of every file. */
const labels = new Map(d.platforms.flatMap((p) => p.files.map((f) => [f.kind, f.label] as const)));

/** The visitor's system → the file of the big button, and its install command. */
const primary: { os: string; kind: Kind; cmd?: { name: string; code: string } }[] = [
  { os: "windows", kind: "win-x64", cmd: windowsCmd },
  { os: "windows-arm", kind: "win-arm64", cmd: windowsCmd },
  { os: "mac", kind: "mac", cmd: unixCmd },
  { os: "linux", kind: "deb-x64", cmd: unixCmd },
  { os: "linux-arm", kind: "deb-arm64", cmd: unixCmd },
  { os: "android", kind: "android" },
];
---
<Base lang={lang} page="download" title={d.title}>
  <PageHead title={d.title} lead={d.lead} />
  <div class="page-body"><div class="wrap">
    {release ? (
      <section class="get panel">
        {(() => {
          const version = (
            <p class="get-version">
              {release.prerelease && <span class="pill pill--yellow">{d.beta}</span>}
              <strong>{num(lang, fill(d.version, "v", release.version))}</strong>
              {release.date && <span class="muted">{num(lang, fill(d.released, "date", release.date))}</span>}
            </p>
          );
          return (
            <>
              <div class="get-alone">{version}</div>
              {primary.filter((p) => got[p.kind]).map((p) => {
                const a = got[p.kind]!;
                return (
                  <div class="get-one" data-os={p.os} hidden>
                    <div class="get-top">
                      <div class="get-info">
                        {version}
                        <h2 class="get-title">{fill(d.forYou, "os", osNames[p.os] ?? p.os)}</h2>
                        <p class="get-file">{labels.get(p.kind)} · {num(lang, size(a.size))} <span class="muted">· {d.picked}</span></p>
                      </div>
                      <a class="dl" href={a.url}>
                        <Icon name="download" class="drop" />
                        <span>{d.downloadWord}</span>
                      </a>
                    </div>
                    {p.cmd && (
                      <div class="get-cmd">
                        <p class="get-cmd-title"><strong>{d.orCommand}</strong></p>
                        <div class="cmd-box">
                          <pre><code>{p.cmd.code}</code></pre>
                          <button class="btn btn--white btn--sm" type="button" data-copy={p.cmd.code} data-done={d.copied}><Icon name="copy" /><span>{d.copy}</span></button>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </>
          );
        })()}
        <p class="get-links">
          <a href="#all">{d.otherSystems}</a>
          <a href={release.url}>{d.releasesPage}</a>
          {release.sums && <a href={release.sums}>{d.checksums}</a>}
        </p>
      </section>
    ) : (
      <section class="get panel">
        <p>{d.unavailable}</p>
        <a class="btn btn--lg" href={`${REPO}/releases`}><Icon name="download" class="drop" />{d.releasesPage}</a>
      </section>
    )}

    {release && (
      <>
        <h2 id="all">{d.otherSystems}</h2>
        <div class="systems">
          {d.platforms.map((p) => {
            const list = p.files.filter((f) => got[f.kind as Kind]);
            if (list.length === 0) return null;
            return (
              <article class="system panel" data-system={p.id}>
                <h3><span class="tile tile--sm"><Icon name={icons[p.id] ?? "download"} /></span>{p.name}</h3>
                <p class="muted">{p.note}</p>
                <ul>
                  {list.map((f) => {
                    const a = got[f.kind as Kind]!;
                    return (
                      <li>
                        <a class="file" href={a.url}>
                          <Icon name="download" class="drop" />
                          <span class="file-name">{f.label}</span>
                          <span class="file-size">{num(lang, size(a.size))}</span>
                        </a>
                        {a.sha256 && <details><summary>{d.sha}</summary><code>{a.sha256}</code></details>}
                      </li>
                    );
                  })}
                </ul>
              </article>
            );
          })}
        </div>
      </>
    )}

    <h2>{d.commandTitle}</h2>
    <p class="prose muted">{d.commandText}</p>
    <div class="cmds">
      {commands.map((c, i) => (
        <section class="cmd">
          <h3><span class="tile tile--sm"><Icon name={i === 0 ? "terminal" : "windows"} /></span>{c.name}</h3>
          <div class="cmd-box"><pre><code>{c.code}</code></pre><button class="btn btn--white btn--sm" type="button" data-copy={c.code} data-done={d.copied}><Icon name="copy" /><span>{d.copy}</span></button></div>
        </section>
      ))}
    </div>
    <p class="prose muted">{d.commandNote}</p>

    <h2>{d.toolsTitle}</h2>
    <p class="prose muted">{d.toolsText}</p>

    <h2>{d.updatesTitle}</h2>
    <p class="prose muted">{d.updatesText}</p>

    <h2>{d.signingTitle}</h2>
    <dl class="rows">
      <div><dt><span class="tile tile--sm"><Icon name="windows" /></span>Windows</dt><dd>{d.signingWindows}</dd></div>
      <div><dt><span class="tile tile--sm"><Icon name="laptop" /></span>macOS</dt><dd>{d.signingMac}</dd></div>
      <div><dt><span class="tile tile--sm"><Icon name="phone" /></span>Android</dt><dd>{d.signingAndroid}</dd></div>
    </dl>

    <h2>{d.verifyTitle}</h2>
    <p class="prose muted">{d.verifyText}</p>
    <pre><code>{d.verifyCode}</code></pre>

    <h2>{d.sourceTitle}</h2>
    <p class="prose muted">{d.sourceText} <a href={`${REPO}#quick-start`}>GitHub</a></p>
  </div></div>
</Base>

<script>
  // Which system is this? Only the user agent (and, in Chromium, the processor type) is read;
  // nothing is stored or sent anywhere.
  type UAData = { getHighEntropyValues(hints: string[]): Promise<{ architecture?: string }> };
  async function isArm(): Promise<boolean> {
    const data = (navigator as Navigator & { userAgentData?: UAData }).userAgentData;
    try {
      return (await data?.getHighEntropyValues(["architecture"]))?.architecture === "arm";
    } catch {
      return false;
    }
  }
  async function system(): Promise<string> {
    const ua = navigator.userAgent;
    if (/Android/i.test(ua)) return "android";
    if (/Windows/i.test(ua)) return (await isArm()) ? "windows-arm" : "windows";
    if (/Macintosh|Mac OS X/i.test(ua) && !/iPhone|iPad/i.test(ua)) return "mac";
    if (/Linux|X11|CrOS/i.test(ua)) return (await isArm()) || /aarch64|arm64/i.test(ua) ? "linux-arm" : "linux";
    return "";
  }

  system().then((os) => {
    const one = os ? document.querySelector<HTMLElement>(`.get-one[data-os="${os}"]`) : null;
    // No match (an unknown system, or no file for it): the list of every system is the choice.
    if (one) one.hidden = false;
    else document.querySelector(".get")?.classList.add("get--none");
    const family = os.replace(/-arm$/, "");
    const card = family ? document.querySelector<HTMLElement>(`.system[data-system="${family}"]`) : null;
    if (card) {
      card.classList.add("system--yours");
      card.parentElement?.prepend(card);
    }
  });

  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    b.addEventListener("click", async () => {
      const label = b.querySelector("span");
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? "");
        const was = label?.textContent ?? "";
        if (label) label.textContent = b.dataset.done ?? "";
        setTimeout(() => { if (label) label.textContent = was; }, 1500);
      } catch {
        // No clipboard (an old browser, a page not in focus): the command stays selectable.
      }
    });
  }
</script>

<style>
  .get { display: grid; gap: var(--s4); }
  .get-version { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s2); margin: 0; font-size: 1.125rem; }
  .get-version .muted { font-weight: 500; }
  /* The version alone only when no system was picked; otherwise it heads the picked one. */
  .get-alone { display: none; }
  .get--none .get-alone { display: block; }

  .get-one { display: grid; gap: var(--s4); }
  .get-one[hidden] { display: none; }

  /* What it is on the left, the download button on the right; stacked on a phone. */
  .get-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s3) var(--s6); }
  .get-info { display: grid; gap: var(--s1); min-width: 0; }
  .get-title { margin: var(--s1) 0 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; }
  .get-file { margin: 0; font-weight: 700; }
  .get-file .muted { font-weight: 500; }

  .dl { display: inline-flex; align-items: center; justify-content: center; gap: var(--s2); min-block-size: 4.5rem; padding: var(--s2) var(--s6) var(--s2) var(--s4); border: var(--edge) solid var(--navy); border-radius: var(--r-pill); background: var(--yellow); color: var(--navy); font-size: clamp(1.5rem, 2.6vw, 1.875rem); font-weight: 800; line-height: 1; white-space: nowrap; text-decoration: none; box-shadow: var(--drop-btn); transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease); }
  .dl:hover { transform: translateY(-0.125rem); box-shadow: 0 0.5rem 0 var(--navy); }
  .dl:active { transform: translateY(0.25rem); box-shadow: 0 0.125rem 0 var(--navy); }
  .dl:focus-visible { outline-offset: 5px; }
  .dl .ico { inline-size: 2.5rem; block-size: 2.5rem; padding: 0.45rem; border-radius: 50%; background: var(--navy); color: var(--yellow); }
  @media (max-width: 48rem) { .dl { width: 100%; } }

  .get-cmd { display: grid; gap: var(--s1); min-width: 0; }
  .get-cmd-title { margin: 0; font-size: var(--t-small); }
  .get-links { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s3); margin: 0; padding-top: var(--s3); border-top: 2px solid var(--line); font-weight: 700; font-size: var(--t-small); }
  .get--none .get-links { border-top: 0; padding-top: 0; font-size: 1.25rem; }

  /* A command shown whole (it wraps instead of scrolling sideways), with its copy button in
     the box's corner; on a phone the button goes under it. */
  /* A command is one line: on a screen too narrow for it, it scrolls sideways; the copy button
     sits beside it. */
  .cmd-box { display: flex; align-items: center; gap: var(--s2); width: 100%; padding: var(--s1) var(--s1) var(--s1) var(--s3); border: var(--edge) solid var(--navy); border-radius: var(--r-small); background: var(--white); }
  .cmd-box pre { flex: 1; min-width: 0; margin: 0; padding: var(--s1) 0; border: 0; border-radius: 0; background: none; white-space: pre; overflow-x: auto; scrollbar-width: thin; line-height: 1.5; }
  .cmd-box .btn { flex: none; }
  .cmds { display: grid; gap: var(--s4); }
  .cmd h3 { display: flex; align-items: center; margin: 0 0 var(--s2); font-size: var(--t-h3); }

  .systems { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--s4); }
  .system h3 { display: flex; align-items: center; margin: 0; font-size: var(--t-h3); }
  .system > p { margin: var(--s1) 0 var(--s2); }
  .system--yours { background: var(--yellow); }
  .system ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  /* Each file is one row to press: icon, what it is, its size. */
  .file { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--s2); min-block-size: 3rem; padding: var(--s1) var(--s2); border: 2px solid var(--navy); border-radius: var(--r-small); background: var(--white); color: var(--navy); text-decoration: none; font-weight: 700; line-height: 1.25; box-shadow: 0 0.1875rem 0 var(--navy); transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease), background-color var(--fast) var(--ease); }
  .file:hover { transform: translateY(-0.125rem); box-shadow: 0 0.3125rem 0 var(--navy); background: var(--paper); }
  .file:active { transform: translateY(0.125rem); box-shadow: 0 0.0625rem 0 var(--navy); }
  .file:focus-visible { outline-offset: 3px; }
  .file-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .file-size { font-size: var(--t-small); font-weight: 600; color: var(--ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .system details { font-size: var(--t-small); border: 0; padding: 0; margin: var(--s1) 0 0 var(--s1); background: none; box-shadow: none; }
  .system summary { font-size: var(--t-small); font-weight: 700; color: var(--ink-2); }
  .system details code { display: block; overflow-wrap: anywhere; color: var(--ink-2); }
</style>
