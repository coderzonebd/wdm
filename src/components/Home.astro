---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import Chart from "./Chart.astro";
import PowerBar from "./PowerBar.astro";
import Wind from "./Wind.astro";
import { href, strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const h = t.home;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const shot = (x: 1 | 2) => `${base}shots/app-${lang}-light${x === 1 ? "-1x" : ""}.webp`;
---
<Base lang={lang} page="home">
  <section class="hero">
    <div class="hero-clip"><Wind /></div>
    <div class="wrap">
      <p class="pill">{h.soon}</p>
      <h1 class="display">{h.title1}<br /><span class="hl">{h.title2}</span></h1>
      <p class="lead soft">{h.lead}</p>
      <div class="actions">
        <a class="btn" href={href(lang, "download")}>{h.cta}</a>
        <a class="btn btn--white" href={href(lang, "benchmarks")}>{h.cta2}</a>
      </div>
      <ul class="pills">{h.platforms.map((p) => <li class="pill">{p}</li>)}</ul>
      <figure class="hero-shot">
        <div class="frame">
          <img src={shot(1)} srcset={`${shot(1)} 1240w, ${shot(2)} 2480w`} sizes="(max-width: 82rem) 92vw, 73rem" width="1240" height="760" alt={h.shot.alt} />
        </div>
      </figure>
    </div>
  </section>

  <section class="band band--paper after-hero">
    <div class="wrap">
      <p class="caption muted small">{h.shot.caption}</p>
    </div>
    <div class="wrap split" style="margin-top:var(--s12)">
      <div>
        <h2>{h.fast.title}</h2>
        <p class="lead muted">{h.fast.text}</p>
        <p><a href={href(lang, "benchmarks")}>{h.fast.link}</a></p>
      </div>
      <Chart lang={lang} />
    </div>
  </section>

  <section class="band band--navy">
    <div class="wrap">
      <h2 class="page-title">{h.power.title1}<br /><span class="hl">{h.power.title2}</span></h2>
      <p class="lead soft" style="margin-top:var(--s4)">{h.power.text}</p>
      <PowerBar label={h.power.barLabel} cut={h.power.cut} resume={h.power.resume} />
      <ul class="results">
        {h.power.results.map((r) => <li><span class="figure">{r.value}</span><span class="soft">{r.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="page-title">{h.all.title1}<br /><span class="hl-blue">{h.all.title2}</span></h2>
      <ul class="features">
        {h.all.items.map((f) => <li><h3>{f.title}</h3><p>{f.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="band band--yellow">
    <div class="wrap split">
      <div>
        <h2>{h.browser.title}</h2>
        <p class="lead">{h.browser.text}</p>
        <p><a href={href(lang, "extension")}>{h.browser.link}</a></p>
      </div>
      <div class="duo">
        <div><h3>{h.honest.title}</h3><p>{h.honest.text} <a href={href(lang, "privacy")}>{h.honest.link}</a></p></div>
        <div><h3>{h.lang.title}</h3><p>{h.lang.text}</p></div>
      </div>
    </div>
  </section>

  <section class="band band--blue closing" id="support">
    <div class="wrap">
      <h2 class="page-title">{h.title1}<br /><span class="hl">{h.title2}</span></h2>
      <p class="lead soft">{t.support.text}</p>
      <div class="actions">
        <a class="btn" href={href(lang, "download")}>{h.cta}</a>
        <a class="btn btn--white" href="https://github.com/sponsors/coderzonebd">{t.support.sponsors}</a>
        <a class="btn btn--white" href="https://buymeacoffee.com/devrkb21">{t.support.coffee}</a>
      </div>
    </div>
  </section>
</Base>
