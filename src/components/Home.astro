---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import Chart from "./Chart.astro";
import KillGrid from "./KillGrid.astro";
import { href, REPO, strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const h = t.home;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const shot = (scheme: "light" | "dark", x: 1 | 2) => `${base}shots/app-${lang}-${scheme}${x === 1 ? "-1x" : ""}.webp`;
---
<Base lang={lang} page="home">
  <section class="hero wrap">
    <h1 class="display">{h.title}</h1>
    <div class="hero-sub">
      <p class="lead">{h.lead}</p>
      <div class="actions">
        <a class="btn" href={href(lang, "download")}>{h.ctaDownload}</a>
        <a href={REPO}>{h.ctaGithub}</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <ul class="ledger">
      {h.stats.map((s) => <li><span class="figure">{s.value}</span><span class="muted small">{s.label}</span></li>)}
    </ul>
  </div>

  <figure class="shot wrap">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset={`${shot("dark", 1)} 1240w, ${shot("dark", 2)} 2480w`} sizes="(max-width: 75rem) 100vw, 72rem" />
      <img src={shot("light", 1)} srcset={`${shot("light", 1)} 1240w, ${shot("light", 2)} 2480w`} sizes="(max-width: 75rem) 100vw, 72rem" width="1240" height="760" alt={h.shot.alt} />
    </picture>
    <figcaption class="muted small">{h.shot.caption}</figcaption>
  </figure>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>{h.statsTitle}</h2>
        <p class="muted">{h.statsNote}</p>
        <p><a href={href(lang, "benchmarks")}>{h.statsLink}</a></p>
      </div>
      <Chart lang={lang} />
    </div>
  </section>

  <section class="section night">
    <div class="wrap kill">
      <KillGrid label={h.kill.gridLabel} />
      <div class="kill-text">
        <h2>{h.kill.title}</h2>
        <p class="muted">{h.kill.text}</p>
        <ul class="results">
          {h.kill.results.map((r) => <li><span class="figure">{r.value}</span><span class="muted small">{r.label}</span></li>)}
        </ul>
        <p class="muted">{h.kill.why}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{h.featuresTitle}</h2>
      <dl class="spec">
        {h.features.map((f) => <div><dt>{f.title}</dt><dd>{f.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap pair">
      <div><h3>{h.privacyTitle}</h3><p class="muted">{h.privacyText} <a href={href(lang, "privacy")}>{h.privacyLink}</a></p></div>
      <div><h3>{h.langTitle}</h3><p class="muted">{h.langText}</p></div>
    </div>
  </section>

  <section class="section support" id="support" style="padding-top:0">
    <div class="wrap">
      <h2>{t.support.title}</h2>
      <p class="lead">{t.support.text} {t.support.other}</p>
      <p class="actions">
        <a href="https://github.com/sponsors/coderzonebd">{t.support.sponsors}</a>
        <a href="https://buymeacoffee.com/devrkb21">{t.support.coffee}</a>
      </p>
    </div>
  </section>
</Base>
