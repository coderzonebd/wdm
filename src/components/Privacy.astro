---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import PageHead from "./PageHead.astro";
import Icon from "./Icon.astro";
import { strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = strings[lang].privacy;
---
<Base lang={lang} page="privacy" title={p.title}>
  <PageHead title={p.title} lead={p.updated} />
  <div class="page-body"><div class="wrap">
    <dl class="rows" data-reveal>
      {p.sections.map((s) => <div><dt><span class="tile tile--sm"><Icon name="lock" /></span>{s.h}</dt><dd>{s.p}</dd></div>)}
    </dl>
  </div></div>
</Base>
