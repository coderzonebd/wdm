---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import { strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const e = strings[lang].extension;
---
<Base lang={lang} page="extension" title={e.title}>
  <div class="page wrap">
    <h1 class="display">{e.title}</h1>
    <p class="lead">{e.lead}</p>
    <h2>{e.browsersTitle}</h2>
    <dl class="spec">
      {e.browsers.map((b) => <div><dt>{b.name}</dt><dd>{b.text}</dd></div>)}
    </dl>
    <h2>{e.featuresTitle}</h2>
    <ul class="bullets prose">{e.features.map((f) => <li>{f}</li>)}</ul>
  </div>
</Base>
