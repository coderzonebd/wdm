---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import { strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const e = strings[lang].extension;
---
<Base lang={lang} page="extension" title={e.title}>
  <div class="page wrap prose">
    <h1>{e.title}</h1>
    <p class="lead">{e.lead}</p>
    <h2>{e.browsersTitle}</h2>
    {e.browsers.map((b) => <div class="card" style="margin:12px 0"><h3>{b.name}</h3><p>{b.text}</p></div>)}
    <h2>{e.featuresTitle}</h2>
    <ul>{e.features.map((f) => <li>{f}</li>)}</ul>
  </div>
</Base>
