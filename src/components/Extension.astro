---
// SPDX-License-Identifier: GPL-3.0-or-later
import Base from "../layouts/Base.astro";
import PageHead from "./PageHead.astro";
import Icon from "./Icon.astro";
import { strings, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const e = strings[lang].extension;
---
<Base lang={lang} page="extension" title={e.title}>
  <PageHead title={e.title} lead={e.lead} />
  <div class="page-body"><div class="wrap">
    <h2>{e.featuresTitle}</h2>
    <ul class="bullets prose" data-reveal>{e.features.map((f) => <li>{f}</li>)}</ul>
    <h2>{e.browsersTitle}</h2>
    <dl class="rows" data-reveal>
      {e.browsers.map((b) => <div><dt><span class="tile tile--sm"><Icon name="globe" /></span>{b.name}</dt><dd>{b.text}{b.url && <p class="store"><a class="btn btn--white" href={b.url}><Icon name="download" class="drop" />{b.cta}</a></p>}</dd></div>)}
    </dl>
  </div></div>
</Base>

<style>
  .store { margin: var(--s2) 0 0; }
</style>
